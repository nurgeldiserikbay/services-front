# Browser-internal or public API host; never place session secrets in NEXT_PUBLIC variables.
SERVICES_API_BASE_URL=http://127.0.0.1:3001/v1

# Customer completion BFF is disabled by default. Enable only after account
# login/cookie issuance, same-origin CSRF, backend release parity, staging and
# ingress security review have all been approved.
SERVICES_WEB_ENABLE_CUSTOMER_COMPLETION=disabled

# Registered-customer own request list is default-off until verified account login,
# current-backend compatibility and browser/staging acceptance.
SERVICES_WEB_ENABLE_CUSTOMER_REQUESTS=disabled

# Registered customer request creation is independently default-off. Enable only
# with approved backend SERVICES_ENABLE_REGISTERED_REQUEST_CREATE_HTTP=enabled,
# authenticated account login, same-origin CSRF, abuse budgets and staging sign-off.
SERVICES_WEB_ENABLE_CUSTOMER_REQUEST_CREATE=disabled

# Guest completion is disabled by default. Enable ONLY after backend PR #364,
# trusted ingress proof stripping/signing, OTP provider security review,
# HTTPS same-origin CSRF, real-browser/staging acceptance and operator approval.
SERVICES_WEB_ENABLE_GUEST_COMPLETION_BFF=disabled
# GUEST_NETWORK_ATTESTATION_KEY must be a 32-byte base64 secret shared only
# by trusted ingress/backend/BFF; never accept an unsigned client network claim.
